<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5">

    <!-- رأس التطبيق -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="محاسبة بقالتي 2.0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#2E7D32"
        android:padding="12dp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- مؤشرات الصندوق والمبيعات -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvCashBalance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="الصندوق: غير متاح"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvTodaySales"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مبيعات اليوم: غير متاح"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:gravity="center"/>
    </LinearLayout>

    <!-- حقول إدخال عملية البيع -->
    <EditText
        android:id="@+id/etItemSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="بحث عن صنف (مثال: أرز، سكر)..."
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:background="#FFFFFF"/>

    <EditText
        android:id="@+id/etQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="الكمية المباعة"
        android:inputType="number"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"/>

    <!-- زر تنفيذ البيع -->
    <Button
        android:id="@+id/btnExecuteSale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="البيع غير متاح حاليًا"
        android:backgroundTint="#2E7D32"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- الأزرار الإضافية التي تطابق البرمجة تماماً -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPrintStatement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="طباعة كشف الحساب"
            android:backgroundTint="#424242"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnShareReport"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مشاركة تقرير اليوم"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
